// Шаблон реферата по дисциплине «Информационные системы и технологии»
// Основа: СТУ 7.5–07–2021 СФУ, разделы 6–7, приложения Н и У.
// Подписи и даты подписей из формы Н опущены по согласованной логике
// электронной сдачи. Если преподаватель требует точную форму Н, восстановите их.

#set page(
  paper: "a4",
  margin: (top: 2cm, bottom: 2cm, left: 3cm, right: 1cm),
  // Титульный лист считается страницей 1, но номер на нём не отображается.
  // Начиная со страницы 2, номер выводится снизу по центру.
  footer: context {
    if counter(page).get().first() > 1 {
      align(center)[#counter(page).display("1")]
    }
  },
)
#set text(font: "Times New Roman", size: 14pt, lang: "ru")
#set par(
  justify: true,
  first-line-indent: (amount: 1.25cm, all: true),
  // Одинарный интервал — допустимый вариант по СТУ.
  // Значение указано явно, чтобы не полагаться на настройки среды сборки.
  leading: 0.2em,
  // Между обычными абзацами не добавляется дополнительный пустой интервал:
  // абзацы разделяются отступом первой строки.
  spacing: 0pt,
)
#set list(
  marker: "-",
  indent: 1.25cm,
  body-indent: 0.5cm,
)

// Заголовки структурных элементов: прописные буквы, полужирный,
// по центру, без нумерации. Каждый такой элемент начинается с новой страницы.
#let structural_heading(title) = [
  #align(center)[
    #set par(first-line-indent: 0pt, spacing: 0pt)
    #text(weight: "bold")[#title]
  ]
  #v(1em)
]

// Нумерованные заголовки основной части.
// Все уровни начинаются с одинакового абзацного отступа 1,25 см.
// После номера нет точки.
#let section_heading(number, title) = [
  #v(1em)
  #block(width: 100%)[
    #set par(first-line-indent: 0pt, spacing: 0pt)
    #pad(left: 1.25cm)[
      #text(weight: "bold")[#number #title]
    ]
  ]
  #v(1em)
]

// ── ДАННЫЕ ТИТУЛЬНОГО ЛИСТА ──────────────────────────────────────────────────
#let institute = "Гуманитарный институт"
#let department = "[Полное название кафедры]"
#let discipline = "Информационные системы и технологии"
#let topic = "[Название темы реферата]"
#let group = "ГФ26-02Б"
#let authors = "[Фамилии и инициалы всех участников]"
#let recordbooks = "[Номера зачётных книжек — если требуются преподавателем]"
#let teacher = "Илья Ильич [фамилия]"
#let city = "Красноярск"
#let year = "2026"

// ── ТИТУЛЬНЫЙ ЛИСТ (приложение Н) ─────────────────────────────────────────────
#align(center)[
  #set par(first-line-indent: 0pt, spacing: 0pt)
  Министерство науки и высшего образования Российской Федерации

  #v(0.3cm)
  #text(weight: "bold")[
    Федеральное государственное автономное образовательное учреждение
    высшего образования
    «СИБИРСКИЙ ФЕДЕРАЛЬНЫЙ УНИВЕРСИТЕТ»
  ]

  #v(0.4cm)
  #institute

  #department

  #v(2.5cm)
  #text(weight: "bold")[РЕФЕРАТ]

  #v(0.4cm)
  по дисциплине «#discipline»

  #v(0.5cm)
  на тему:

  #topic
]

#v(2cm)
#align(right)[
  #set par(first-line-indent: 0pt, spacing: 0pt)
  Преподаватель: #teacher \
  Студенты: #authors \
  Группа: #group \
  № зачётных книжек: #recordbooks
]

#v(1fr)
#align(center)[
  #set par(first-line-indent: 0pt, spacing: 0pt)
  #city #year
]

#pagebreak()

// Содержание для документов объёмом до 24 страниц СТУ не рекомендует.
// Если преподаватель требует содержание или документ больше 24 страниц,
// добавьте отдельный раздел «СОДЕРЖАНИЕ» после этой строки и перед введением.
// Содержание должно отражать все заголовки и корректные номера страниц.

// ── ВВЕДЕНИЕ ──────────────────────────────────────────────────────────────────
#structural_heading("ВВЕДЕНИЕ")

[Кратко опишите актуальность темы и сформулируйте цель и задачи работы.]

Цель работы — [сформулируйте цель].

Для достижения цели необходимо решить следующие задачи:

#[
  #set par(first-line-indent: 0pt, spacing: 0pt)
  - [Задача 1]
  - [Задача 2]
  - [Задача 3]
]

// ── ОСНОВНАЯ ЧАСТЬ ───────────────────────────────────────────────────────────
// Оставьте только необходимые разделы и подразделы. Не сдавайте незаполненные
// заготовки. Заголовки начинаются с прописной буквы и не заканчиваются точкой.

#section_heading("1", "Название первого раздела")

[Раскройте первый вопрос темы. Заимствованные факты сопровождайте ссылками, например #text("[1, с. 15]").]

#section_heading("1.1", "Название подраздела")

[При необходимости разбейте раздел на законченные по смыслу подразделы.]

#section_heading("2", "Название второго раздела")

[Раскройте следующий вопрос семинара. При необходимости используйте таблицы, иллюстрации и формулы по памятке STU_GUIDE.md.]

// ── ЗАКЛЮЧЕНИЕ ───────────────────────────────────────────────────────────────
#pagebreak()
#structural_heading("ЗАКЛЮЧЕНИЕ")

[Сформулируйте выводы по работе и соотнесите их с целью и задачами из введения.]

// ── СПИСОК ИСПОЛЬЗОВАННЫХ ИСТОЧНИКОВ ─────────────────────────────────────────
#pagebreak()
#structural_heading("СПИСОК ИСПОЛЬЗОВАННЫХ ИСТОЧНИКОВ")

// Ниже — примеры формата, а не реальные источники. Удалите неиспользованные
// записи. Выберите один принцип упорядочивания и соблюдайте его по всему списку.
// В этой заготовке предполагается систематический порядок: по первому упоминанию.
#enum(
  [Фамилия, И. О. Название книги : вид издания / И. О. Фамилия. – Город : Издательство, год. – 250 с.],
  [Фамилия, И. О. Название статьи / И. О. Фамилия // Название журнала. – Год. – Т. 10, № 2. – С. 15–23.],
  [Название веб-страницы или документа // Название сайта : официальный сайт. – Год. – URL: https://example.org (дата обращения: ДД.ММ.ГГГГ).],
)
