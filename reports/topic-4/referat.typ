#let city = "Красноярск"
#let year = "2026"

#align(center)[
  #text(weight: "bold")[#university]
  \
  #institute
  \
  #department
  #v(3cm)
  #text(size: 16pt, weight: "bold")[РЕФЕРАТ]
  \
  по дисциплине «#discipline»
  \
  на тему:
  \
  #text(size: 16pt, weight: "bold")[#topic]
]
#v(2cm)
#align(right)[
  Выполнили: #authors \
  Группа: #group \
  Проверил: #teacher
]
#v(2cm)
#align(center)[#city, #year]

#pagebreak()
#outline(title: [Содержание], depth: 2)
#pagebreak()

